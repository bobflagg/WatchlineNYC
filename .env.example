# ---------------------------------------------------------------------------
# WatchlineNYC-Discovery — environment template
#
# Copy to .env and fill in. .env is gitignored and must stay that way; it
# holds live credentials.
#
#   cp .env.example .env
#
# langgraph dev loads .env automatically (declared via "env": ".env" in
# langgraph.json), as does watchline.shared.connections via python-dotenv.
# ---------------------------------------------------------------------------


# ---- Neo4j (required) -----------------------------------------------------
# Read by watchline/shared/connections.py. The agent's access must be
# READ-ONLY — prefer a read-only role/account here if the deployment has one
# (see specs/roadmap.md, D4).

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional — connections.py defaults to "discovery" if unset.
NEO4J_DISCOVERY_DATABASE=discovery


# ---- Model providers ------------------------------------------------------
# ANTHROPIC_API_KEY is the one the agent needs; this project builds on Claude.
# The others are present in the current .env and kept here for parity, but
# nothing in the planned build requires them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=


# ---- LangSmith tracing (add in Phase 0) -----------------------------------
# Not yet in .env. The ecosystem-primer treats these as always-on for any
# LangChain/LangGraph project, and specs/roadmap.md turns tracing on from
# Phase 0. These are the current variable names — older ones no longer work.

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=watchline-discovery-agent


# ---- Geosupport sidecar (add in Phase 0/2) --------------------------------
# Not yet in .env. Addresses resolve through NYC DCP Geosupport running as a
# sidecar service (specs/roadmap.md, D9), because python-geosupport is
# Windows/Linux-only and this project runs natively on macOS.
#
# GEOSUPPORT_RELEASE must match the release the ingestion pipeline uses, or
# agent-side and pipeline-side geocoding can disagree on edge cases. Keep it
# as one shared constant rather than a literal in two Dockerfiles.

GEOSUPPORT_URL=http://localhost:8080
GEOSUPPORT_RELEASE=25b
