# Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# --- Secrets (LLM + web search) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: web search in deep investigations. Omit and web_search degrades gracefully.
TAVILY_API_KEY=tvly-...

# --- Neo4j (the container's own DB) ---
# Any password; the app reuses it. NEO4J_AUTH is derived as neo4j/<this>.
NEO4J_PASSWORD=change-me-strong
# The Google Drive FILE ID of the dump — the part between /d/ and /view in the share
# URL (…/file/d/<THIS>/view). A full share URL also works. The file MUST be shared
# "Anyone with the link → Viewer" or gdown can't fetch it. Seeded ONCE onto the
# neo4j-data volume.
DISCOVERY_GDRIVE_ID=
# Neo4j memory — size to your VM (defaults assume ~32GB total). For a LOCAL Docker
# test on a laptop, drop these (e.g. 2g / 4g) so they fit Docker Desktop's VM.
NEO4J_HEAP=8g
NEO4J_PAGECACHE=12g

# --- Model (optional) ---
# Leave unset for production default (claude-sonnet-5). Set to run cheaper, e.g.:
# WATCHLINE_MODEL=claude-haiku-4-5-20251001
WATCHLINE_MODEL=

# --- Tracing (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# --- Access (Caddy) ---
# A domain (e.g. watchline.example.com) gives automatic HTTPS. For an IP-only POC use :80
SITE_ADDRESS=:80
BASIC_AUTH_USER=stakeholder
# bcrypt hash from:  docker run --rm caddy caddy hash-password --plaintext 'your-password'
# IMPORTANT: bcrypt hashes contain '$', which docker compose reads as a variable.
# Double every '$' here (write $$ for each $), e.g. $2a$14$... becomes $$2a$$14$$...
# The same applies to any value with a literal '$' (e.g. NEO4J_PASSWORD).
BASIC_AUTH_HASH=
